# --- Required: free LLM (Groq has a free tier) ---
# Live models (see https://console.groq.com/docs/models):
#   openai/gpt-oss-20b (fast, 1000 t/s) | llama-3.1-8b-instant (560 t/s)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# --- Free local embeddings (no key needed) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# --- Required: web fallback search ---
TAVILY_API_KEY=
# --- Required: vector DB (Pinecone has a free tier) ---
PINECONE_API_KEY=
PINECONE_INDEX_NAME=fde-it-support-rag
PINECONE_NAMESPACE=company-it-kb

# --- Optional overrides ---
ADMIN_API_KEY=change-me
APP_ENV=development

# --- Legacy paid OpenAI (optional, only if you switch back) ---
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
